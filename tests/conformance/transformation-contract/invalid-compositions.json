  "composition_cases": [
    {
      "id": "reject-cross-currency",
      "edge": {
        "from": "map.cash-delta-usd",
        "to": "reduce.cash-eur",
        "to_port": "deltas"
      },
      "expected_category": "currency_mismatch",
      "reason": "USD money cannot enter a EUR reduction without an explicit FX operation and policy."
    },
    {
      "id": "reject-cross-unit",
      "edge": {
        "from": "map.cash-delta-usd",
        "to": "reduce.quantity-usd",
        "to_port": "deltas"
      },
      "expected_category": "unit_mismatch",
      "reason": "Money and share quantity remain different units even when a container type name matches."
    },
    {
      "id": "reject-context-change",
      "edge": {
        "from": "map.cash-delta-usd",
        "to": "reduce.cash-context-b",
        "to_port": "deltas"
      },
      "expected_category": "context_mismatch",
      "reason": "Results at different settlement cutoffs cannot be silently composed."
    },
    {
      "id": "reject-operation-type",
      "edge": {
        "from": "map.cash-delta-usd",
        "to": "reduce.position-type",
        "to_port": "deltas"
      },
      "expected_category": "operation_type_mismatch",
      "reason": "A money-delta output is not a position-delta input."
    },
    {
      "id": "reject-unresolved-lifecycle",
      "edge": {
        "from": "normalize.raw-lifecycle",
        "to": "fold.position-resolved",
        "to_port": "resolved-events"
      },
      "expected_category": "unresolved_lifecycle_input",
      "reason": "Raw originate/correct records must be resolved to one active economic event before projection."
    }
  ],
